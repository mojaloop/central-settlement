{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // audit-ci supports reading JSON, JSONC, and JSON5 config files.
  // Only use one of ["low": true, "moderate": true, "high": true, "critical": true]
  "moderate": true,
  "allowlist": [ // NOTE: Please add as much information as possible to any items added to the allowList
    "GHSA-hp3w-g68c-fv3c", // sprintf-js has no patched release; it is transitive through test and schema-generation tooling, with no untrusted format strings.
    "GHSA-vfj7-8cjw-p6xm" // braces has no patched release; it is transitive through file-watching and schema-generation tooling, with no untrusted glob patterns.
  ]
}
